APP_NAME=AI Document Assistant
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_document_assistant
STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.70
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# For public demos use production, HTTPS frontend origins, and managed secrets.
APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=[]
CHAT_REQUESTS_PER_MINUTE=20
UPLOAD_REQUESTS_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60
